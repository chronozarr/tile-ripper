+#[allow(clippy::too_many_arguments)]
+fn collect_selected(
+    context: BTreeV1CollectContextStorage<'_>,
+    address: u64,
+    parent: Option<(&[u64], &[u64], u8)>,
+    low: &[u64],
+    high: &[u64],
+    steps: &[u64],
+    visited: &mut HashSet<u64>,
+    results: &mut Vec<(BTreeV1Key, u64)>,
+) -> Result<()> {
+    if !visited.insert(address) {
+        return Err(Error::InvalidData(
+            "B-tree v1 traversal revisits node".into(),
+        ));
+    }
+    let node = read_node_storage(context, address)?;
+    if node.node_type != 1 || (node.level > 0 && node.children.is_empty()) {
+        return Err(Error::InvalidData("invalid raw-data v1 node".into()));
+    }
+    let keys = node
+        .keys
+        .iter()
+        .map(raw_offsets)
+        .collect::<Result<Vec<_>>>()?;
+    if keys.iter().any(|k| k.len() != low.len()) || keys.windows(2).any(|k| k[0] >= k[1]) {
+        return Err(Error::InvalidData(
+            "unordered or invalid v1 chunk keys".into(),
+        ));
+    }
+    if let Some((a, b, level)) = parent {
+        if node.level.checked_add(1) != Some(level) || keys[0] != a || *keys.last().unwrap() != b {
+            return Err(Error::InvalidData(
+                "v1 child level/boundaries disagree with parent".into(),
+            ));
+        }
+    }
+    // Validate visible pointers even when their intervals will be skipped.
+    let mut children = HashSet::new();
+    for (i, &child) in node.children.iter().enumerate() {
+        let key = keys[i];
+        if key.last() != Some(&0)
+            || key
+                .iter()
+                .zip(context.chunk_dims)
+                .any(|(o, d)| o % u64::from(*d) != 0)
+        {
+            return Err(Error::InvalidData("unaligned v1 chunk origin".into()));
+        }
+        if Cursor::is_undefined_offset(child, context.offset_size)
+            || !children.insert(child)
+            || (node.level > 0 && visited.contains(&child))
+        {
+            return Err(Error::InvalidData(
+                "invalid or repeated v1 child pointer".into(),
+            ));
+        }
+        let needed = if node.level == 0 {
+            match node.keys[i] {
+                BTreeV1Key::RawData { chunk_size, .. } if chunk_size > 0 => u64::from(chunk_size),
+                _ => return Err(Error::InvalidData("zero-sized allocated v1 chunk".into())),
+            }
+        } else {
+            8 + 2 * u64::from(context.offset_size)
+        };
+        if child
+            .checked_add(needed)
+            .map_or(true, |end| end > context.storage.len())
+        {
+            return Err(Error::OffsetOutOfBounds(child));
+        }
+    }
+    for i in 0..node.children.len() {
+        let intersects =
+            grid_successor(keys[i], low, high, steps).is_some_and(|p| p.as_slice() < keys[i + 1]);
+        if !intersects {
+            continue;
+        }
+        if node.level == 0 {
+            // A sparse index can bracket an absent chunk. Only return exact
+            // grid members, never the preceding record from the key interval.
+            if keys[i]
+                .iter()
+                .zip(low)
+                .zip(high)
+                .all(|((v, a), b)| v >= a && v <= b)
+            {
+                results.push((node.keys[i].clone(), node.children[i]));
+            }
+        } else {
+            collect_selected(
+                context,
+                node.children[i],
+                Some((keys[i], keys[i + 1], node.level)),
+                low,
+                high,
+                steps,
+                visited,
+                results,
+            )?;
+        }
+    }
+    Ok(())
+}
