+/// Select raw-data v1 B-tree leaves without reading unrelated branches.
+///
+/// Bounds are inclusive **chunk indices**, one per dataset dimension. A box is
+/// a Cartesian product, not a single lexicographic interval. Keys include the
+/// trailing byte dimension; its selected origin is zero. Physical chunk file
+/// addresses do not participate in ordering. Missing records remain absent.
+///
+/// This checks every key and pointer in visited nodes, strict key ordering,
+/// child levels and parent/child boundary agreement. Like indexed lookup in
+/// libhdf5, it trusts unread subtrees to obey their advertised boundaries. It
+/// cannot certify corruption confined to an unread subtree. Use the existing
+/// full collector when whole-index structural traversal is required.
+pub fn collect_btree_v1_leaves_storage_selective(
+    storage: &dyn Storage,
+    root_address: u64,
+    offset_size: u8,
+    length_size: u8,
+    chunk_dims: &[u32],
+    first: &[u64],
+    last: &[u64],
+) -> Result<Vec<(BTreeV1Key, u64)>> {
+    let invalid = || Error::InvalidData("invalid selective v1 chunk bounds".into());
+    if chunk_dims.is_empty()
+        || chunk_dims.len() > 32
+        || first.len() != chunk_dims.len()
+        || last.len() != chunk_dims.len()
+        || !matches!(offset_size, 2 | 4 | 8)
+        || !matches!(length_size, 2 | 4 | 8)
+    {
+        return Err(invalid());
+    }
+    let mut low = Vec::with_capacity(first.len() + 1);
+    let mut high = Vec::with_capacity(first.len() + 1);
+    let mut steps = Vec::with_capacity(first.len() + 1);
+    for ((&a, &b), &d) in first.iter().zip(last).zip(chunk_dims) {
+        if d == 0 || a > b {
+            return Err(invalid());
+        }
+        low.push(a.checked_mul(u64::from(d)).ok_or_else(invalid)?);
+        high.push(b.checked_mul(u64::from(d)).ok_or_else(invalid)?);
+        steps.push(u64::from(d));
+    }
+    low.push(0);
+    high.push(0);
+    steps.push(1);
+    let context = BTreeV1CollectContextStorage {
+        storage,
+        offset_size,
+        length_size,
+        ndims: Some(chunk_dims.len() as u32),
+        chunk_dims,
+        chunk_bounds: Some((first, last)),
+    };
+    let mut results = Vec::new();
+    let mut visited = HashSet::new();
+    if !Cursor::is_undefined_offset(root_address, offset_size) {
+        collect_selected(
+            context,
+            root_address,
+            None,
+            &low,
+            &high,
+            &steps,
+            &mut visited,
+            &mut results,
+        )?;
+    }
+    Ok(results)
+}
+
+fn raw_offsets(key: &BTreeV1Key) -> Result<&[u64]> {
+    match key {
+        BTreeV1Key::RawData { offsets, .. } => Ok(offsets),
+        _ => Err(Error::InvalidData(
+            "selective v1 traversal requires a raw-data tree".into(),
+        )),
+    }
+}
+
+/// Smallest point of an aligned Cartesian grid that is >= a lexicographic key.
+/// Carry to the preceding dimension when a component exceeds its allowed max.
+fn grid_successor(lower: &[u64], low: &[u64], high: &[u64], step: &[u64]) -> Option<Vec<u64>> {
+    let mut point = low.to_vec();
+    for i in 0..low.len() {
+        let value = lower[i].max(low[i]).div_ceil(step[i]).checked_mul(step[i]);
+        if let Some(value) = value.filter(|v| *v <= high[i]) {
+            point[i] = value;
+            if value > lower[i] {
+                return Some(point);
+            }
+        } else {
+            for j in (0..i).rev() {
+                if let Some(next) = point[j].checked_add(step[j]).filter(|v| *v <= high[j]) {
+                    point[j] = next;
+                    point[j + 1..].copy_from_slice(&low[j + 1..]);
+                    return Some(point);
+                }
+            }
+            return None;
+        }
+    }
+    Some(point)
+}
