+            let step = vec![2; rank];
+            let points: Vec<Vec<u64>> = (0usize..3usize.pow(rank as u32))
+                .map(|mut n| {
+                    let mut p = vec![0; rank];
+                    for d in (0..rank).rev() {
+                        p[d] = 2 + (n % 3) as u64 * 2;
