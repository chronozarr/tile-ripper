{
  "url": "https://raw.githubusercontent.com/opengeos/terrio/main/Cargo.toml",
  "relevant_manifest_lines": [
    "rust-version = \"1.90\"",
    "netcdf-reader = { version = \"0.9\", default-features = false, features = [\"netcdf4\"] }",
    "hdf5-reader = { version = \"0.9\", default-features = false }",
    "# geometry and plan file, among others) fail in hdf5-reader 0.9.1, and old fill value messages",
    "# read wrong. Fixed in roteiro-gis/netcdf-rust#95; until a release carries it, build against that",
    "hdf5-core = { git = \"https://github.com/gpt-cmdr/netcdf-rust\", rev = \"24ff6fcfcc79a35c30aa5d8cb3028ab4d9d00564\" }",
    "hdf5-reader = { git = \"https://github.com/gpt-cmdr/netcdf-rust\", rev = \"24ff6fcfcc79a35c30aa5d8cb3028ab4d9d00564\" }",
    "netcdf-core = { git = \"https://github.com/gpt-cmdr/netcdf-rust\", rev = \"24ff6fcfcc79a35c30aa5d8cb3028ab4d9d00564\" }",
    "netcdf-reader = { git = \"https://github.com/gpt-cmdr/netcdf-rust\", rev = \"24ff6fcfcc79a35c30aa5d8cb3028ab4d9d00564\" }"
  ]
}
