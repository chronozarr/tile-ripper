 impl FilesystemStoreOptions {
+    /// On macOS, use POSIX fsync on each write instead of File::sync_all's
+    /// device-wide F_FULLFSYNC. Default false; no effect on other platforms.
+    /// The caller must flush the device after synchronising all transaction
+    /// files and directories, before publication, and after its rename.
+    /// File contents and metadata are still synchronised before handles close,
+    /// so delayed write errors cannot be lost by reopening files later.
+    pub fn defer_device_flush(&mut self, defer: bool) -> &mut Self {
+        self.defer_device_flush = defer;
+        self
+    }
